# ==============================================================================
# Configuración de entorno de referencia (SIN SECRETOS REALES)
# Copiar a `.env` para desarrollo local: `cp .env.example .env`
# ==============================================================================

# Identidad parametrizada del producto
NODE_ENV=development
APP_NAME="Mesa de Truco"

# Puertos y binding de servicios
API_HOST=0.0.0.0
API_PORT=3001
GAME_SERVER_HOST=0.0.0.0
GAME_SERVER_PORT=3002
GAME_SERVER_INTERNAL_URL=http://127.0.0.1:3002
WEB_PORT=5173
ADMIN_PORT=5174

# PostgreSQL 16 (docker-compose + Drizzle ORM)
POSTGRES_USER=truco_dev
POSTGRES_PASSWORD=change_me_local_pg_password
POSTGRES_DB=truco_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://truco_dev:change_me_local_pg_password@localhost:5432/truco_dev

# Redis 7 (salas vivas, caché, presencia, rate limit, BullMQ)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Sesiones, cookies y seguridad criptográfica (mínimo 32 caracteres aleatorios en prod)
SESSION_SECRET=replace_with_32_plus_char_session_secret_placeholder
INTERNAL_RPC_SECRET=replace_with_32_plus_char_internal_rpc_secret_placeholder
REFRESH_TOKEN_TTL=2592000
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SEED_ENCRYPTION_KEY=replace_with_64_hex_char_key_for_seed_commitment_storage

# OAuth Google (dejar vacío si está deshabilitado en desarrollo local)
# En producción se valida criptográficamente por JWKS contra Google Identity
# (apps/api/src/modules/auth/providers/google-jwks.verifier.ts).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=

# Proveedor de email (uno de: console | resend | smtp)
# - console: ConsoleEmailProvider (desarrollo; escribe el email a stdout)
# - resend: usar Resend (https://resend.com) → requiere RESEND_API_KEY
# - smtp: SMTP genérico (SMTP Connection URL) → requiere SMTP_CONNECTION_URL
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=Mesa de Truco <no-reply@example.com>
# Obsoleto: usar RESEND_API_KEY (EMAIL_PROVIDER=resend) o SMTP_CONNECTION_URL (EMAIL_PROVIDER=smtp).
EMAIL_PROVIDER_API_KEY=
RESEND_API_KEY=
SMTP_CONNECTION_URL=
# Base URL pública de la web (se usa para armar links en emails transaccionales)
WEB_BASE_URL=http://localhost:5173

# Proveedor de captcha adaptativo ("disabled" o "turnstile" en producción)
# https://www.cloudflare.com/products/turnstile/
CAPTCHA_PROVIDER=disabled
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=

# Filtro configurable adicional de términos bloqueados en apodos (separados por coma, opcional)
NICKNAME_BLOCKED_TERMS=

# Límites de tasa (Rate Limiting)
RATE_LIMIT_HTTP_WINDOW_MS=60000
RATE_LIMIT_HTTP_MAX=120
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_WS_ACTION_MAX=30
RATE_LIMIT_WS_CHAT_MAX=10
RATE_LIMIT_TABLE_CREATE_MAX=6

# Límites de conexiones WebSocket simultáneas (M8b/ADR-019)
# Por usuario autenticado (evita pestañas zombis o abuso de un solo jugador)
WS_MAX_CONNECTIONS_PER_USER=4
# Por IP de origen real (60 = contempla NAT/CGNAT móvil y aulas; bajar en entornos controlados)
WS_MAX_CONNECTIONS_PER_IP=60

# Proxies confiables (ADR-020/ADR-022): lista separada por comas de CIDRs desde los que
# se acepta la cabecera TRUSTED_PROXY_HEADER con la IP real del cliente.
# Si está vacío (desarrollo), las cabeceras x-forwarded-for/cf-connecting-ip se ignoran.
#
# En staging/producción hay DOS consumidores con valores DISTINTOS:
#   - Caddy (infra/caddy/Caddyfile): los rangos de Cloudflare
#       TRUSTED_PROXY_CIDRS=$(curl -s https://www.cloudflare.com/ips-v4 | paste -sd, -)
#     Caddy sólo acepta CF-Connecting-IP si el par TCP viene de esos rangos.
#   - API y game-server: la red interna de Docker (los fija el compose)
#       TRUSTED_PROXY_CIDRS=172.16.0.0/12
# Nunca poner 0.0.0.0/0: haría spoofeable la IP del cliente.
TRUSTED_PROXY_CIDRS=
# Cabecera que trae la IP real. Con Caddy delante, la API recibe x-forwarded-for YA
# reescrito por Caddy con la IP resuelta (no usar cf-connecting-ip en la API).
TRUSTED_PROXY_HEADER=x-forwarded-for

# Dominio y certificados (sólo los usa Caddy; ver docs/DEPLOY.md)
APP_DOMAIN=truco.ar
ACME_EMAIL=ops@truco.ar
# Puertos publicados en el host por Caddy (80/443 en el VPS; altos para el smoke test de CI)
HTTP_PORT=80
HTTPS_PORT=443

# Parámetros operativos de partida en tiempo real
TURN_TIMEOUT_MS=30000
RECONNECT_GRACE_MS=45000
# Limpieza de salas inactivas en el game-server (TTL sin conexiones = 10 minutos)
IDLE_ROOM_TTL_MS=600000
IDLE_ROOM_SWEEP_MS=60000

# Observabilidad (OpenTelemetry y Sentry)
# Las trazas sólo se activan si el paquete está instalado (ver docs/RUNBOOKS.md#trazas).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
OTEL_TRACES_SAMPLER_ARG=0.1
# Niveles: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Token exigido en `Authorization: Bearer` de GET /v1/metrics (vacío = endpoint deshabilitado)
METRICS_TOKEN=

# Panel administrativo: origen separado del jugador y (opcional) restricción por red
# Ejemplo: ADMIN_ALLOWED_NETWORKS=10.0.0.0/8,192.168.0.0/16,203.0.113.7 (vacío = sin restricción)
ADMIN_ORIGIN=
ADMIN_ALLOWED_NETWORKS=

# Respaldos de PostgreSQL (ver docs/RUNBOOKS.md#respaldos)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# Almacenamiento S3 compatible (backups cifrados / exportaciones, opcional en dev)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
