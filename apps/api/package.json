{
  "name": "@truco/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed:dev": "tsx src/db/seed-dev.ts",
    "db:seed:perf": "tsx scripts/perf/seed-perf-data.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "admin:create": "tsx scripts/admin-create.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@nestjs/common": "^11.2.4",
    "@nestjs/core": "^11.2.4",
    "@nestjs/platform-fastify": "^11.2.4",
    "@truco/engine": "workspace:*",
    "@truco/shared": "workspace:*",
    "argon2": "^0.45.2",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.2",
    "ioredis": "^5.5.0",
    "jose": "^6.2.18",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@nestjs/testing": "^11.2.4",
    "@truco/config": "workspace:*",
    "@truco/game-server": "workspace:^",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.17.0",
    "fast-check": "^3.22.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
