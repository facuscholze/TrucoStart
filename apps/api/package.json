    "@nestjs/platform-fastify": "^11.2.4",
    "@truco/engine": "workspace:*",
    "@truco/shared": "workspace:*",
    "fastify": "^5.12.2",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.4",
    "@truco/config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
