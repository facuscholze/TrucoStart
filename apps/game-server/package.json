{
  "name": "@truco/game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "perf:actions": "tsx scripts/perf-action-latency.ts"
  },
  "dependencies": {
    "@truco/engine": "workspace:*",
    "@truco/shared": "workspace:*",
    "bullmq": "^5.34.0",
    "ioredis": "^5.5.0",
    "pino": "^9.6.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@truco/config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
